# ===========================================================================
# Fashion AI — Environment Configuration Example
# Copy to .env if custom settings are needed.
# No secret is required for the defaults (Open-Meteo is keyless, trends use
# public editorial sources, LLM extraction is disabled).
# ===========================================================================

# --- Server ---
PORT=8000

# Profile access is OFF by default. Only enable on a private single-user server.
# PROFILE_LOCAL_MODE=1
# PROFILE_DATABASE_URL=sqlite+aiosqlite:///./profiles.db

# --- Weather Provider (Open-Meteo public API requires no API key) ---
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# Optional commercial Open-Meteo API key (leave unset for free tier; never commit real keys)
# WEATHER_API_KEY=

# --- Weather reliability & caching ---
WEATHER_API_TIMEOUT=10
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_CACHE_MAX_SIZE=128
WEATHER_MAX_FORECAST_DAYS=16
WEATHER_TIMEZONE=auto

# Optional explicit fallback location (unset by default — no city is assumed)
# WEATHER_DEFAULT_LOCATION=
# WEATHER_DEFAULT_LATITUDE=
# WEATHER_DEFAULT_LONGITUDE=

# Optional Vosk acoustic model directory override
# VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# ===========================================================================
# Global Fashion Trend Module
# ===========================================================================

# --- Database (SQLite by default; PostgreSQL optional) ---
# Leave unset to use <repo>/trends.db (preserved historical data lives there).
# DATABASE_URL=sqlite+aiosqlite:///./trends.db
# SYNC_DATABASE_URL=sqlite:///./trends.db
# Set to 1 to force SQLite even if DATABASE_URL is configured.
# USE_SQLITE=1

# --- Trend API (standalone module app) ---
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO

# --- Scoring (overrides config/scoring.yaml) ---
HALF_LIFE_DAYS=30
TREND_SIMILARITY_THRESHOLD=0.58
WINDOW_DAYS=30

# --- LLM extraction (provider-agnostic, optional, disabled by default) ---
LLM_ENABLED=false
LLM_PROVIDER=dummy
LLM_MODEL=dummy
LLM_API_KEY=
LLM_API_BASE=
LLM_MAX_CALLS_PER_DAY=100

# --- Collection / scheduling ---
USER_AGENT=FashionTrendBot/1.0 (+https://example.com/bot)
DEFAULT_TIMEOUT=15
MAX_URLS_PER_SOURCE=5
RATE_LIMIT_DELAY=2.0
# Production snapshots exclude synthetic seed data (1 = exclude)
EXCLUDE_SYNTHETIC=1
# Background scheduler is opt-in and never started inside the API process
TREND_SCHEDULER_ENABLED=0
TREND_SNAPSHOT_INTERVAL_HOURS=6
