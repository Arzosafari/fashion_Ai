# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trends
# For sync tools (alembic, scripts): postgresql://postgres:postgres@localhost:5432/trends
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trends

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Scoring (overrides config/scoring.yaml if set)
HALF_LIFE_DAYS=30
WINDOW_DAYS=30

# LLM (provider-agnostic, optional)
LLM_ENABLED=false
LLM_PROVIDER=dummy
LLM_MODEL=dummy
LLM_API_KEY=
LLM_API_BASE=
LLM_MAX_CALLS_PER_DAY=100

# Collection
USER_AGENT=FashionTrendBot/1.0 (+https://example.com/bot)
DEFAULT_TIMEOUT=15
